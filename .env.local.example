# Supabase（必須）
# https://supabase.com/dashboard/project/_/settings/api から取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# メール通知（Resend）
# https://resend.com で API キーを発行
# API キーの「名前」はラベルだけで、送信元アドレスとは無関係です
RESEND_API_KEY=re_xxxxxxxx

# テスト時は必ず onboarding@resend.dev（jukenseiweb@resend.dev などは使えません）
# 届け先は Resend アカウント登録メールと同じアドレスのみ（サンドボックス制限）
EMAIL_FROM=onboarding@resend.dev

# 通知メール内リンク用
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Discord 通知（管理者向け）
# Discord サーバーのチャンネル設定 → 連携サービス → Webhook → URL をコピー
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx

# Google カレンダー（コーチング予約の自動登録）
# 1. Google Cloud Console で Calendar API を有効化
# 2. サービスアカウントを作成し、JSON キーを発行
# 3. Google カレンダーをサービスアカウントのメールアドレスと共有（予定の変更権限）
# 4. カレンダー ID は Google カレンダーの設定 → カレンダーの統合 から確認（メール形式 or primary）
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
