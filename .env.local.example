# Supabase（必須）
# https://supabase.com/dashboard/project/_/settings/api から取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# メール通知（Resend）
# https://resend.com で API キーを発行
# API キーの「名前」はラベルだけで、送信元アドレスとは無関係です
RESEND_API_KEY=re_xxxxxxxx

# テスト時は必ず onboarding@resend.dev（jukenseiweb@resend.dev などは使えません）
# 届け先は Resend アカウント登録メールと同じアドレスのみ（サンドボックス制限）
EMAIL_FROM=onboarding@resend.dev

# 通知メール内リンク用
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push（VAPID）
# 生成例（秘密値をコミットしない）:
#   npx web-push generate-vapid-keys --json
# NEXT_PUBLIC_VAPID_PUBLIC_KEY のみブラウザ公開。VAPID_PRIVATE_KEY は server-only。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 連絡先 mailto: または https: URL（後工程の送信処理で使用）
VAPID_SUBJECT=mailto:you@example.com
# 文字列が厳密に true のときだけ実送信を許可（未設定・false・その他は送信しない）
PUSH_SENDING_ENABLED=false

# Discord 通知（管理者向け）
# Discord サーバーのチャンネル設定 → 連携サービス → Webhook → URL をコピー
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx

# 学習記録デイリーダイジェスト（毎朝8:00 JST / Vercel Cron）
# Supabase ダッシュボード → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ランダムな文字列（Vercel Cron が Authorization: Bearer ... で付与）
CRON_SECRET=your-random-cron-secret

# Google カレンダー（コーチング予約の自動登録）
# 1. Google Cloud Console で Calendar API を有効化
# 2. サービスアカウントを作成し、JSON キーを発行
# 3. Google カレンダーをサービスアカウントのメールアドレスと共有（予定の変更権限）
# 4. カレンダー ID は Google カレンダーの設定 → カレンダーの統合 から確認（メール形式 or primary）
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
